# Backend configuration.
#
# Copy this file to backend/.env and fill it in:  cp .env.example .env
# The server reads backend/.env at startup (Node's built-in loadEnvFile, no
# dotenv dependency). A variable already present in the real environment wins
# over this file, so the credentials Railway injects always take precedence.
#
# NEVER commit a filled-in .env — it is gitignored.
# HTTP server
PORT=3001
HOST=0.0.0.0

# CORS: the origin allowed to call this API (the deployed frontend).
FRONTEND_URL=http://localhost:3000

# AI provider credentials.
# Any key that is missing simply marks that provider as "unavailable";
# the benchmark still runs with the remaining providers.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Provider mode: "real" uses the official SDKs, "mock" uses deterministic
# in-process stubs (used by tests and by the E2E suite). Defaults to "real".
AI_PROVIDER_MODE=real

# Model overrides. Defaults live in backend/src/config/models.ts.
# The defaults are not matched for capability tier — pin comparable models
# here if you want a fair comparison.
GEMINI_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=
