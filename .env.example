# AI Provider API Keys
# You can use standard names or the hyphenated aliases:
OPENAI_API_KEY=your_openai_api_key_here
# Alias: OPEN-AI-KEY=your_openai_api_key_here

ANTHROPIC_API_KEY=your_claude_api_key_here
# Alias: CLAUDE-KEY=your_claude_api_key_here
# Note: For Anthropic user-scoped keys (starting with sk-ant-usr-), set the workspace ID:
ANTHROPIC_WORKSPACE_ID=

GEMINI_API_KEY=your_gemini_api_key_here

# Provider Mode (real or mock)
AI_PROVIDER_MODE=real

# Server Configuration
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000